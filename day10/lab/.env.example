# Day 10 Lab — copy thành .env và điền nếu cần
#   cp .env.example .env

# ChromaDB (khuyến nghị tách collection khỏi Day 09)
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=day10_kb

# Embedding (SentenceTransformers — offline; fallback ONNX nếu thiếu torch, xem embedding.py)
# Corpus lab toàn tiếng Việt → dùng model ĐA NGỮ để retrieval chuẩn (mặc định).
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Bản tiếng Anh nhẹ hơn (yếu trên tiếng Việt — chỉ dùng nếu không tải được model trên):
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Freshness SLA (giờ) — dùng trong monitoring/freshness_check.py
FRESHNESS_SLA_HOURS=24

# Tuỳ chọn: OpenAI chỉ cần nếu nhóm mở rộng eval bằng LLM-judge
# OPENAI_API_KEY=
